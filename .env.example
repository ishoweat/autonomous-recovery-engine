# .env.example

APP_ENV=production
ENVIRONMENT=development

POSTGRES_DB=recovery_engine
POSTGRES_USER=recovery
POSTGRES_PASSWORD=replace-with-a-long-random-password

# For local development without Docker:
DATABASE_URL=sqlite+aiosqlite:///./recovery.db

BACKEND_PORT=8000
FRONTEND_PORT=3000

NEBIUS_API_KEY=your_nebius_api_key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# GitHub Personal Access Token (PAT)
# Required permissions:
# - For public repos: workflow (read), contents (write), pull-requests (write)
# - For private repos: full 'repo' scope + workflow (read/write)
GITHUB_TOKEN=your_github_token
GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/auth/github/callback
FRONTEND_URL=http://localhost:3000

CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

LOG_LEVEL=INFO
 
# Webhook Forwarding Configuration (for local development)
# Providers: smee, gh, cloudflare, ngrok
TUNNEL_PROVIDER=smee
WEBHOOK_PROXY_URL=https://smee.io/your-smee-channel-id
# GITHUB_REPO=owner/repo (if using TUNNEL_PROVIDER=gh)
# TUNNEL_HOSTNAME=your-domain.com (if using TUNNEL_PROVIDER=cloudflare)
# NGROK_DOMAIN=your-ngrok-domain.ngrok-free.app (if using TUNNEL_PROVIDER=ngrok)

# Autonomous Recovery Engine Phase Feature Flags (Default: false)
ENABLE_PERSISTENCE=false
ENABLE_WEBHOOK_INGRESS=false
ENABLE_APPROVAL_GATE=false
ENABLE_BLOCK_ESCALATION=false
ENABLE_SANDBOX_HARDENING=false
ENABLE_AUTO_MERGE=false
ENABLE_POST_MERGE_VERIFY=false
ENABLE_REAL_METRICS=false
ASSUMED_ENGINEER_HOURLY_USD=85
ASSUMED_MANUAL_FIX_HOURS=1.5

# --- Phase 8 Flags ---
PUBLIC_DEMO_MODE=false
ENABLE_RATE_LIMITING=false
ENABLE_TAVILY_RESEARCH=false
TAVILY_API_KEY=
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Phase 10 Flags ---
ENABLE_FORK_AND_PR=false
FORK_PR_REQUIRE_APPROVAL=true
FORK_PR_POLL_INTERVAL=5
FORK_PR_MAX_POLL_WAIT=120
