# deploy/.env.prod.example - Production Environment Template
# Copy this file to .env on your production server

APP_ENV=production
ENVIRONMENT=production
LOG_LEVEL=INFO

# Database
POSTGRES_DB=recovery_engine
POSTGRES_USER=recovery
POSTGRES_PASSWORD=REPLACE-WITH-STRONG-DB-PASSWORD
DATABASE_URL=postgresql+asyncpg://recovery:REPLACE-WITH-STRONG-DB-PASSWORD@postgres:5432/recovery_engine
DATABASE_PATH=/data/recovery.db

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Nebius LLM Token Factory
NEBIUS_API_KEY=REPLACE-WITH-NEBIUS-API-KEY
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# GitHub Integration
GITHUB_TOKEN=REPLACE-WITH-GITHUB-PAT
GITHUB_WEBHOOK_SECRET=REPLACE-WITH-RANDOM-WEBHOOK-SECRET

# GitHub OAuth
GITHUB_CLIENT_ID=REPLACE-WITH-GITHUB-CLIENT-ID
GITHUB_CLIENT_SECRET=REPLACE-WITH-GITHUB-CLIENT-SECRET
GITHUB_REDIRECT_URI=https://REPLACE-WITH-BACKEND-HOST/auth/github/callback

# Domains & CORS
CORS_ORIGINS=https://REPLACE-WITH-NETLIFY-FRONTEND-URL,http://localhost:3000
FRONTEND_URL=https://REPLACE-WITH-NETLIFY-FRONTEND-URL

# Live Web Research
TAVILY_API_KEY=REPLACE-WITH-TAVILY-API-KEY

# Feature Flags
SHADOW_MODE=false
PUBLIC_DEMO_MODE=false
ENABLE_PERSISTENCE=true
ENABLE_WEBHOOK_INGRESS=true
ENABLE_APPROVAL_GATE=true
ENABLE_BLOCK_ESCALATION=true
ENABLE_SANDBOX_HARDENING=true
ENABLE_AUTO_MERGE=true
ENABLE_POST_MERGE_VERIFY=true
ENABLE_REAL_METRICS=true
ENABLE_RATE_LIMITING=true
ENABLE_TAVILY_RESEARCH=true
ENABLE_FORK_AND_PR=true
ENABLE_LLM_CACHE=false
ENABLE_BENCHMARK_VIEW=true
ENABLE_DEMO_SCENARIOS=false
